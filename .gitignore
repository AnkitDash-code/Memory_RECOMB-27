# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Downloaded datasets (squidpy/scanpy cache).
# Leading slash matters: a bare `data/` also matches `src/data/`, which silently
# excluded the entire data-loader package from the repo.
/data/

# Large intermediate checkpoints (h5ad snapshots, ~100-300MB each) -- keep
# the small .pt model weights, but not these, to avoid bloating the repo
outputs/checkpoints/*.h5ad

# Cached H&E patches (float32 arrays) and frozen-encoder image features
# (~2GB total across 12 DLPFC slices) -- reproducible from raw data via
# src/data/extract_patches.py / src/models/image_encoder.py, not source.
outputs/cache/
